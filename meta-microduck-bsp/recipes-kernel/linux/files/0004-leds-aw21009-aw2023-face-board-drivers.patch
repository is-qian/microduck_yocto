+ *****************************************************/
+static void
+aw210xx_update_cfg_array(struct aw210xx *aw210xx, uint8_t *p_cfg_data, uint32_t cfg_size)
+{
+	unsigned int i = 0;
+
+	for (i = 0; i < cfg_size; i += 2)
+		aw210xx_i2c_write(aw210xx, p_cfg_data[i], p_cfg_data[i + 1]);
+}
