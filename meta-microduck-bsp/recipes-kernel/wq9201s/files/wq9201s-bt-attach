#!/bin/sh
# Attach the WQ9201S Bluetooth controller on UART1 as an H4 HCI.
#
# Follows Seeed's working image (their wq9201s-bt-attach):
#   - The BT firmware is downloaded over SDIO by wq_wlan, and wlan0 appearing is
#     the sign it is done. Attaching before that gets a controller that never
#     answers.
#   - H4 at 1500000, through btattach (hciattach is the AIC8800's tool).
#   - Never `hciattach ... 3wire` (H5) in the same boot: it locks the controller
#     out of H4 until the next reboot.
#   - A controller that attached but reports an all-zero address did not really
#     come up; detach and try again.
set -u

for _ in $(seq 1 30); do
	[ -e /sys/class/net/wlan0 ] && break
	sleep 1
done
sleep 3

for attempt in 1 2 3; do
	pkill -f 'btattach.*ttyS1' 2>/dev/null
	sleep 1
	btattach -B /dev/ttyS1 -N -P h4 -S 1500000 >/dev/null 2>&1 &
	sleep 4
	mac=$(hciconfig hci0 2>/dev/null | grep -oE '([0-9A-F]{2}:){5}[0-9A-F]{2}' | head -n1)
	if [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ]; then
		# BlueZ adds a second rfkill node for hci0 itself, born blocked; the
		# AIC8800 notes in docs/agents/zero3-board.md have the story.
		rfkill unblock bluetooth 2>/dev/null || true
		hciconfig hci0 up
		echo "WQ9201S Bluetooth up (H4), address $mac"
		# Stay in the foreground while btattach holds the line discipline.
		wait
		exit 0
	fi
	echo "WQ9201S Bluetooth attach attempt $attempt failed (address '${mac}')" >&2
done

echo "WQ9201S Bluetooth failed after 3 attempts; if H5 was tried this boot, reboot" >&2
exit 1
