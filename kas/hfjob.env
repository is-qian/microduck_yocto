# Build paths for a Hugging Face Job.  Usage:
#
#   scripts/build-hfjob.sh
#
# Sourced *inside* the job container, not on a laptop -- none of these paths
# exist anywhere else. Unlike coach there is no second container to bind-mount
# through: the job runs the kas image (ghcr.io/siemens/kas/kas:5.4) directly, and
# that image already starts as an unprivileged `builder` uid, so bitbake's
# refusal to run as root never triggers.
#
# Two filesystems, and which one gets what is the whole design:
#
#   /cache   the pollen-robotics/microduck-yocto storage bucket, mounted
#            read-write. Persists between jobs -- this is the point. Measured on
#            cpu-performance: 480 MB/s reads and 1.2 ms per stat, so bitbake's
#            sstate existence scan costs roughly 7 s across ~6000 tasks, but
#            fetching thousands of small objects through it stalls. So sstate
#            travels as one file, sstate.tar, and downloads/ is read through
#            PREMIRRORS (scripts/build-hfjob.sh has the numbers).
#   $HOME    the ephemeral job disk, a ~1.7 TB overlay, destroyed when the job
#            exits. TMPDIR churns 100 GB+ even with rm_work, so it belongs on
#            local disk rather than a FUSE mount -- and it is reproducible from
#            sstate, so losing it costs nothing but time.
#
# The build dir has to live under $HOME (or /tmp, or /var/tmp -- all three are
# the same overlay). The container root is NOT writable by the kas image's uid
# 30000, so a literal /build dies at mkdir before bitbake ever starts.
#
# KAS_WORK_DIR is deliberately unset. It defaults to the cwd, which is where kas
# checks the upstream layers out as siblings of meta-microduck (see .gitignore).
#
# TMPDIR needs no setting: it defaults to $KAS_BUILD_DIR/tmp.

export KAS_BUILD_DIR=$HOME/build
# Both DL_DIR and SSTATE_DIR are on the LOCAL disk, not the bucket, and neither
# is a preference -- each was measured.
#
# DL_DIR: with it on /cache, fetching JeffyCN's mirrors.git pulled a 10.2 GB pack
# and then sat for over an hour with zero bytes of progress. Moving it local made
# the same fetch complete and the kernel build finish in 25 minutes.
#
# SSTATE_DIR: with it on /cache, sstate reuse was 0% across three consecutive
# identical runs --
#
#   Sstate summary: Wanted 7 Local 0 Mirrors 0 Missed 7 (0% match)
#
# -- even though the objects were plainly in the bucket under exactly the names
# bitbake wanted, and only one hash-set existed (so the cache keys matched, and
# BB_HASHSERVE_DB_DIR in kas/hfjob.yml was working). That was blamed on the mount
# at the time; later 0% runs were traced to editing hfjob.yml/hfjob.env between
# runs, which changes the hashes, so the mount may not have been the cause.
# Either way the directories stay local. sstate is unpacked from one archive,
# /cache/sstate.tar, and rewritten on exit. SSTATE_MIRRORS through the mount was
# tried on 2026-10-05 and stalled in setscene (build-hfjob.sh). downloads/ is
# read on demand through PREMIRRORS (kas/hfjob.yml).
export DL_DIR=$HOME/downloads
export SSTATE_DIR=$HOME/sstate

# KAS_REPO_REF_DIR is deliberately NOT set. Pointing it at /cache looked like a
# free win -- cache the upstream layers' git mirrors between jobs -- and it failed
# exactly as this file previously warned it might:
#
#   git clone -q --reference /cache/repo-refs/git.openembedded.org.meta-openembedded \
#       -- /cache/repo-refs/git.openembedded.org.meta-openembedded .../meta-openembedded
#   fatal: repository '/cache/repo-refs/...' does not exist
#
# kas clones *from* the reference directory, so it has to be a populated mirror
# before the build starts -- not an empty directory for kas to fill in. Cloning
# the five layers takes a couple of minutes against a 2.5-4 h build, so
# pre-seeding mirrors is not worth the moving part.
