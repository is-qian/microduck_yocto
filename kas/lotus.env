# Build paths for the `lotus` laptop.  Usage:
#
#   . kas/lotus.env
#   kas-container build kas/microduck.yml
#
# /home has ~28 GB free, which will not fit a rockchip build, so everything
# lives on /mnt/data.
#
# To reuse coach's output, rsync its sstate straight into SSTATE_DIR -- sstate is
# content-addressed, so merging the directories is all that "sharing" means. No
# SSTATE_MIRRORS needed, and nothing extra to bind-mount:
#
#   rsync -a coach:/data1/fabien/yocto/sstate/ /mnt/data/fabien/yocto/sstate/

export KAS_BUILD_DIR=/mnt/data/fabien/yocto/build
export DL_DIR=/mnt/data/fabien/yocto/downloads
export SSTATE_DIR=/mnt/data/fabien/yocto/sstate
