# Build paths for the `coach` host.  Usage:
#
#   . kas/coach.env
#   kas-container build kas/microduck.yml
#
# These are environment variables, not local.conf settings, because
# kas-container bind-mounts KAS_BUILD_DIR, DL_DIR and SSTATE_DIR into the
# container. A path written into local_conf_header would name a host directory
# the container cannot see.
#
# TMPDIR needs no setting: it defaults to $KAS_BUILD_DIR/tmp.

export KAS_BUILD_DIR=/data1/fabien/yocto/build
export DL_DIR=/data1/fabien/yocto/downloads
export SSTATE_DIR=/data1/fabien/yocto/sstate

# The microduck-daemon recipe fetches a private repo over SSH. That needs two
# things in the container, not one:
#   --ssh-agent   forwards the auth socket (pass on the command line; it validates
#                 that an agent is actually running, so connect with `ssh -A`)
#   KAS_SSH_DIR   supplies known_hosts -- without it the clone fails with
#                 "Could not read from remote repository", because ssh refuses
#                 before authenticating when it cannot verify the host key.
#
# That directory holds known_hosts and nothing else: no private keys go into the
# container, since the forwarded agent does the authenticating. It was seeded from
# the entry coach already trusts (`ssh-keygen -F github.com`), so it introduces no
# new trust decision.
export KAS_SSH_DIR=/data1/fabien/kas-ssh
