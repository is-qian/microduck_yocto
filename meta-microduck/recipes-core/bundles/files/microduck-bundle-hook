#!/bin/sh
# RAUC install-check hook: refuse a bundle built for a different kernel or DTB.
#
# A bundle carries the rootfs, and so /lib/modules, but the kernel and DTB stay in
# the shared `boot` partition. Installing a bundle built after a kernel change onto
# a card with the old kernel gives a slot whose modules do not match what runs --
# the AIC8800 wifi driver among them, so the robot comes up unreachable.
#
# `uname -r` cannot catch that: it is 6.1.84-rockchip-standard whatever config,
# DTS or patch the kernel was built with, and those are the changes this repo makes.
# So the bundle names the exact boot.img it was built with (the [meta.boot] section,
# written by microduck-bundle.bb), and this compares it with the card's `boot`.
#
# This hook REPLACES RAUC's own compatible check, so that check is redone here.
# Exit >= 10 rejects the bundle; RAUC shows the last stderr line as the reason.
[ "$1" = install-check ] || exit 0

if [ "$RAUC_MF_COMPATIBLE" != "$RAUC_SYSTEM_COMPATIBLE" ]; then
	echo "bundle is for '$RAUC_MF_COMPATIBLE', this system is '$RAUC_SYSTEM_COMPATIBLE'" >&2
	exit 10
fi

have=$(head -c "$RAUC_META_BOOT_SIZE" /dev/disk/by-partlabel/boot | sha256sum | cut -d' ' -f1)
if [ "$have" != "$RAUC_META_BOOT_SHA256" ]; then
	echo "bundle was built for another kernel/DTB (boot.img $RAUC_META_BOOT_SHA256, card has $have): reflash the card instead" >&2
	exit 10
fi
