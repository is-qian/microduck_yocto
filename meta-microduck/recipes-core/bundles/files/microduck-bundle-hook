#!/bin/sh
# RAUC hooks for the microduck bundle: install-check, then slot-post-install.
#
# install-check: refuse a card whose U-Boot does not boot the slot's own kernel.
#
# A bundle carries the kernel and DTB in the slot's /boot, next to /lib/modules.
# That only holds together if U-Boot boots them; a card from before (its bootcmd
# runs Rockchip's chain on the `boot` partition) would boot the old kernel against
# the new modules -- the AIC8800 wifi driver among them, so the robot comes up
# unreachable. What U-Boot runs is the bootcmd saved in its environment, so that is
# what is checked, not the U-Boot binary: a card reflashed with bmaptool before #24
# kept its old environment, and with it the old bootcmd, under a new U-Boot.
#
# This hook REPLACES RAUC's own compatible check, so that check is redone here.
# Exit >= 10 rejects the bundle; RAUC shows the last stderr line as the reason.
install_check() {
	if [ "$RAUC_MF_COMPATIBLE" != "$RAUC_SYSTEM_COMPATIBLE" ]; then
		echo "bundle is for '$RAUC_MF_COMPATIBLE', this system is '$RAUC_SYSTEM_COMPATIBLE'" >&2
		exit 10
	fi

	case "$(fw_printenv -n bootcmd 2>/dev/null)" in
	*/boot/microduck.dtb*) ;;
	*)
		echo "this card's U-Boot boots the kernel in the boot partition, not the slot's: reflash it" >&2
		exit 10
		;;
	esac
}

# slot-post-install: carry this slot's /etc/machine-id into the one just written.
#
# The journal lives on the data partition (recipes-core/microduck-data), in a
# directory named after the machine-id. A bundle's rootfs ships it empty, so every
# slot would make up its own on first boot: each update would leave the previous
# journal under an id nothing vacuums any more (SystemMaxUse is per directory), and
# a plain `journalctl --list-boots` would not show the boots of the slot the board
# rolled back from. One id per board keeps one journal across every update.
slot_post_install() {
	id=$(cat /etc/machine-id 2>/dev/null)
	case "$id" in
	*[!0-9a-f]* | "") echo "no valid /etc/machine-id here; the new slot makes its own" >&2; return 0 ;;
	esac
	[ ${#id} -eq 32 ] || return 0
	# The slot was just written from the bundle, so this replaces oe-core's empty
	# file: systemd then skips first-boot presets, which do_rootfs already applied.
	echo "$id" > "$RAUC_SLOT_MOUNT_POINT/etc/machine-id"

	carry_robot_config
}

# Leave this slot's per-robot files on the data partition, where the daemon looks.
#
# The new slot's /etc/robot is the image's. Since daemon PR #483 the owner's edits
# live in /var/lib/robot/robotd.toml and the HF sign-in in /var/lib/robot/hf-token,
# but a robot whose daemon predates that still keeps both in /etc. Copied only
# while the new path is empty, so this does nothing once the daemon has moved
# them: robotd.toml goes to a side file the daemon adopts edits from and deletes;
# the token goes straight to its new path, group and mode kept (`cp -p`). A
# temporary name and `mv`, so a power cut never leaves half a file.
carry_robot_config() {
	data=/var/lib/robot
	mountpoint -q "$data" || { echo "$data is not mounted; robot config not carried" >&2; return 0; }
	if [ -f /etc/robot/robotd.toml ] && [ ! -e "$data/robotd.toml" ]; then
		cp -p /etc/robot/robotd.toml "$data/robotd.toml.from-slot.tmp" &&
			mv "$data/robotd.toml.from-slot.tmp" "$data/robotd.toml.from-slot"
	fi
	# -L: a symlink is the daemon's own link back to the new path, not a token.
	if [ -f /etc/robot/hf-token ] && [ ! -L /etc/robot/hf-token ] && [ ! -e "$data/hf-token" ]; then
		cp -p /etc/robot/hf-token "$data/hf-token.tmp" &&
			mv "$data/hf-token.tmp" "$data/hf-token"
	fi
	return 0
}

case "$1" in
install-check) install_check ;;
slot-post-install) slot_post_install ;;
esac
