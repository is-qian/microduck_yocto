# microduck A/B disk layout (RAUC).
#
# Derived from meta-rockchip's generic-gptdisk.wks.in, which this replaces via
# WKS_FILE in conf/machine/microduck-zero3.conf. Two deliberate differences:
#
#  1. Every partition has an explicit --offset and --fixed-size. In the generic
#     layout each raw partition is sized by its source artifact, so a boot.img
#     that grew by one byte shifted rootfs. Under A/B that is not cosmetic: a
#     bundle built against one layout would write over the wrong partition of
#     another. wic errors out ("File system image of partition ... is larger
#     than its allowed size") rather than shifting anything, which is the point.
#
#  2. uboot_env is reserved even though stage 1 (userspace RAUC only) does not
#     use it, so no later change moves an offset.
#
# The b slots and data are reserved, not populated: they carry no --source, so
# wic only puts them in the GPT. RAUC writes rootfs_b from the bundle.
#
# Sizes, measured rather than guessed (2026-09-17, deploy artifacts on lotus):
#   idblock.img   306 KiB   -> 480K reserved
#   uboot.img       4 MiB   -> 4M    (the generic layout's figure, unchanged)
#   boot.img     16.22 MiB  -> 32M   (it has already grown once, for the camera)
#   rootfs        489 MB used of 844 MB -> 2G
#
# NOTE ON OFFSETS. The upstream Yocto meta-rockchip puts uboot_env at sector
# 8128, which is Rockchip's documented slot for it. We cannot: JeffyCN's layer
# puts uboot.img at 2 MiB (sector 4096..12287), straight over it, and that is
# the layout that boots on this board today. The free gap is instead between
# the end of idblock and 2 MiB, so uboot_env goes at 512 KiB. Sectors 1088..4095
# stay free there, which is where a redundant environment would go if stage 2
# turns out to need CONFIG_ENV_OFFSET_REDUND.
#
#   part          offset      size
#   idblock        32 KiB     480 KiB   (no GPT entry; the bootrom reads sector 64)
#   uboot_env     512 KiB      32 KiB
#   uboot           2 MiB       4 MiB
#   boot_a          6 MiB      32 MiB
#   boot_b         38 MiB      32 MiB
#   rootfs_a       70 MiB       2 GiB
#   rootfs_b     2118 MiB       2 GiB
#   data         4166 MiB       1 GiB
#                            ~5.07 GiB total -- for the 32 GB card, NOT the 2 GB one.
#
# Partition *labels* are load-bearing. RAUC's system.conf addresses slots as
# /dev/disk/by-partlabel/rootfs_a|b, and the stage 2 boot script will set
# root=PARTLABEL=... -- never by partition number.

bootloader --ptable gpt

part --source rawcopy --sourceparams="file=idblock.img" --align 32 --fixed-size 480K --no-table

part --offset 512K --fixed-size 32K  --fstype=none --part-name uboot_env

part --source rawcopy --sourceparams="file=uboot.img" --offset 2M --fixed-size 4M --part-name uboot

part --source rawcopy --sourceparams="file=boot.img" --offset 6M --fixed-size 32M --part-name boot_a
part --offset 38M --fixed-size 32M --fstype=none --part-name boot_b

# rootfs_a keeps RK_ROOTDEV_UUID. That is not decoration: the kernel's
# root=PARTUUID=614e0000-... comes from the chosen-node patch compiled into the
# DTB (recipes-kernel/linux/patches/0001-*), so slot A must carry that partition
# GUID or the board does not boot at all. Stage 2 replaces this with
# root=PARTLABEL= from boot.scr, and then this UUID stops mattering.
#
# One line per partition, no trailing backslashes: wic's parser reads the file a
# line at a time and shlex.splits it, with no continuation handling at all
# (ksparser.py, `for line in conf`). A continued line is a silent syntax error.
part / --source rootfs --offset 70M --fixed-size 2048M --fstype=ext4 --part-name rootfs_a --uuid ${RK_ROOTDEV_UUID} --mkfs-extraopts "${RK_ROOTFS_EXTRAOPTS}"

# Slot B, deliberately empty. RAUC writes the bundle's ext4 image here raw, so
# there is nothing to format at flash time. Its partition GUID is fixed rather
# than random so two builds of the same commit produce the same GPT.
part --offset 2118M --fixed-size 2048M --fstype=none --part-name rootfs_b --uuid 614e0001-0000-4b53-8000-1d28000054a9

# Persistent data, reserved only. No mountpoint on purpose: a wic mountpoint
# writes an /etc/fstab entry, and a failed mount of a partition that a
# differently-flashed card does not have drops the robot into an emergency
# shell. Format and mount it when something actually needs it.
part --offset 4166M --fixed-size 1024M --fstype=none --part-name data
